UCHARDET_VERSION=0.0.8
# Official site (www.freedesktop.org) returns HTTP 418 to GitHub Actions.
# Debian orig tarball is byte-identical (same SHA256).
UCHARDET_URL=https://deb.debian.org/debian/pool/main/u/uchardet/uchardet_0.0.8.orig.tar.xz
UCHARDET_SHA256=e97a60cfc00a1c147a674b097bb1422abd9fa78a2d9ce3f3fdcc2e78a34ac5f0

# Windows/Android have no usable libc iconv; mpv 0.41 uchardet requires iconv.
LIBICONV_VERSION=1.18
LIBICONV_URL=https://ftp.gnu.org/gnu/libiconv/libiconv-1.18.tar.gz
LIBICONV_SHA256=3b08f5f4f9b4eb82f151a7040bfd6fe6c6fb922efe4b1659c66ea933276965e8

# mpv 0.41 GPU path (vo_gpu_next / mpv_render) needs libplacebo >= 6.338.2.
LIBPLACEBO_VERSION=7.360.1
LIBPLACEBO_URL=https://github.com/haasn/libplacebo/archive/refs/tags/v7.360.1.tar.gz
LIBPLACEBO_SHA256=d05fdf90bea2f629eaa2d115e909fd356388ac639e54f77b87a018a6d76224bd

# mpv 0.41 DRM requires libdisplay-info >= 0.1.1. Ubuntu 22.04 has no package.
# GitLab release CDN (your-objectstorage.com) resets TLS from GitHub Actions.
LIBDISPLAY_INFO_VERSION=0.3.0
LIBDISPLAY_INFO_URL=https://deb.debian.org/debian/pool/main/libd/libdisplay-info/libdisplay-info_0.3.0.orig.tar.bz2
LIBDISPLAY_INFO_SHA256=915cc6713b7b2e173a90f9db248fb8994f9668171fecc1e9fded5e36bb34d890

# mpv 0.41 Wayland needs wayland-client >= 1.21 and wayland-protocols >= 1.31.
# Ubuntu 22.04 has 1.20 / 1.25; vendor into prefix when the distro is too old.
WAYLAND_VERSION=1.23.1
WAYLAND_URL=https://deb.debian.org/debian/pool/main/w/wayland/wayland_1.23.1.orig.tar.gz
WAYLAND_SHA256=158ec49af498f2558c7fbf7e8b070d010d4e270cc6076003a18a6c813f87e244

WAYLAND_PROTOCOLS_VERSION=1.44
