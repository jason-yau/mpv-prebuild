ANDROID_API=21
ANDROID_NDK_VERSION=r29

MACOSX_DEPLOYMENT_TARGET=11.0
# glslang (via shaderc) uses std::filesystem, which Apple's libc++ only
# provides from iOS 13.0 / macOS 10.15. macOS min is already 11.0.
IPHONEOS_DEPLOYMENT_TARGET=13.0
